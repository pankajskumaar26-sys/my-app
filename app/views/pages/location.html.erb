<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100 py-16 px-4">

  <div class="max-w-6xl mx-auto">

    <!-- Hero Section -->
    <div class="text-center mb-16">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-pink-600">
        Our Location – Jaipur
      </h1>
      <p class="mt-4 text-gray-600 max-w-3xl mx-auto">
        We proudly provide premium services across Jaipur. Fast response, 24/7 availability, and trusted service in your area.
      </p>
    </div>

    <!-- Highlight Banner -->
    <div class="bg-pink-600 text-white rounded-3xl p-8 text-center shadow-2xl mb-16">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3">
        🚀 Service Available Across Jaipur
      </h2>
      <p class="opacity-90">
        Quick arrival • Professional service • Trusted by clients citywide
      </p>
    </div>

    <!-- Service Areas Grid -->
    <div class="mb-16">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">

        <% [
          "Malviya Nagar", "Vaishali Nagar", "Mansarovar", "Jagatpura",
          "C-Scheme", "Tonk Road", "Jhotwara", "Vidhyadhar Nagar",
          "Sodala", "MI Road", "Bani Park", "Ajmer Road",
          "Raja Park", "Adarsh Nagar", "Gopalpura", "Sanganer",
          "Sitapura", "Pratap Nagar", "Shyam Nagar", "Civil Lines",
          "Kalwar Road", "Hasanpura", "Chitrakoot", "Nirman Nagar",
          "Kanakpura", "Lalkothi", "Durgapura", "Bapu Nagar",
          "Jawahar Nagar", "Transport Nagar", "Ram Nagar", "Mahesh Nagar",
          "Hawa Sadak", "Amer Road", "VKI Area", "Narayan Vihar"
        ].each do |area| %>

          <div class="bg-white rounded-2xl p-5 text-center shadow-md border border-pink-100 hover:shadow-xl hover:-translate-y-1 transition duration-300">
            <div class="text-2xl mb-2">📍</div>
            <p class="font-semibold text-gray-700"><%= area %></p>
          </div>

        <% end %>

      </div>
    </div>

    <!-- Why Choose Us Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">

      <div class="bg-white p-8 rounded-3xl shadow-lg border border-pink-100 text-center">
        <div class="text-3xl mb-4">⚡</div>
        <h3 class="text-xl font-bold text-pink-600 mb-2">Fast Response</h3>
        <p class="text-gray-600">Quick arrival anywhere in Jaipur.</p>
      </div>

      <div class="bg-white p-8 rounded-3xl shadow-lg border border-pink-100 text-center">
        <div class="text-3xl mb-4">💎</div>
        <h3 class="text-xl font-bold text-pink-600 mb-2">Premium Service</h3>
        <p class="text-gray-600">Professional and discreet experience.</p>
      </div>

      <div class="bg-white p-8 rounded-3xl shadow-lg border border-pink-100 text-center">
        <div class="text-3xl mb-4">🕒</div>
        <h3 class="text-xl font-bold text-pink-600 mb-2">24/7 Available</h3>
        <p class="text-gray-600">Day or night, we are always available.</p>
      </div>

    </div>

    <!-- Map Section -->
    <div class="mt-10">
      <div class="rounded-3xl overflow-hidden shadow-2xl border border-pink-100">
        <iframe
          src="https://maps.google.com/maps?q=Jaipur,Rajasthan&output=embed"
          width="100%"
          height="450"
          style="border:0;"
          loading="lazy">
        </iframe>
      </div>
    </div>

  </div>

</div>