<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100">

  <!-- HERO SECTION -->
  <div class="text-center py-20 px-4">
    <h1 class="text-4xl sm:text-5xl font-extrabold text-pink-600 mb-6">
      Our Premium Services
    </h1>
    <p class="max-w-2xl mx-auto text-gray-600 text-lg">
      Experience luxury, privacy and professionalism with our exclusive services.
    </p>
  </div>

  <!-- SERVICES GRID -->
  <div class="max-w-6xl mx-auto px-4 pb-20">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">

      <!-- Service Card -->
      <div class="bg-white rounded-3xl shadow-xl p-8 text-center hover:shadow-2xl transition duration-500 border border-pink-100">
        <div class="text-4xl mb-4">💎</div>
        <h3 class="text-xl font-bold text-pink-600 mb-3">VIP Escort Service</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          High-class professional companionship for premium clients seeking luxury experiences.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8 text-center hover:shadow-2xl transition duration-500 border border-pink-100">
        <div class="text-4xl mb-4">🌙</div>
        <h3 class="text-xl font-bold text-pink-600 mb-3">Overnight Booking</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Enjoy extended private time with complete comfort and personalized attention.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8 text-center hover:shadow-2xl transition duration-500 border border-pink-100">
        <div class="text-4xl mb-4">🏨</div>
        <h3 class="text-xl font-bold text-pink-600 mb-3">Hotel Visits</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Discreet hotel meetups with full privacy and confidentiality guaranteed.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8 text-center hover:shadow-2xl transition duration-500 border border-pink-100">
        <div class="text-4xl mb-4">🚗</div>
        <h3 class="text-xl font-bold text-pink-600 mb-3">Outcall Service</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          We travel to your preferred location ensuring safety and discretion.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8 text-center hover:shadow-2xl transition duration-500 border border-pink-100">
        <div class="text-4xl mb-4">🎉</div>
        <h3 class="text-xl font-bold text-pink-600 mb-3">Party Companion</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Elegant presence at private events, parties, and special occasions.
        </p>
      </div>

      <div class="bg-white rounded-3xl shadow-xl p-8 text-center hover:shadow-2xl transition duration-500 border border-pink-100">
        <div class="text-4xl mb-4">🔒</div>
        <h3 class="text-xl font-bold text-pink-600 mb-3">100% Privacy</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Your confidentiality and safety are our highest priority at all times.
        </p>
      </div>

    </div>

  </div>

  <!-- WHY CHOOSE US -->
  <div class="bg-white py-20 px-4">
    <div class="max-w-5xl mx-auto text-center">

      <h2 class="text-3xl sm:text-4xl font-bold text-pink-600 mb-6">
        Why Choose Us?
      </h2>

      <p class="text-gray-600 max-w-3xl mx-auto leading-relaxed mb-12">
        We combine professionalism, elegance, and discretion to provide a luxurious and safe experience tailored to your needs.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">

        <div>
          <h4 class="text-lg font-semibold text-gray-800 mb-2">✔ Verified Profiles</h4>
          <p class="text-gray-500 text-sm">Authentic and trusted companions only.</p>
        </div>

        <div>
          <h4 class="text-lg font-semibold text-gray-800 mb-2">✔ 24/7 Availability</h4>
          <p class="text-gray-500 text-sm">Book anytime with quick confirmation.</p>
        </div>

        <div>
          <h4 class="text-lg font-semibold text-gray-800 mb-2">✔ Complete Discretion</h4>
          <p class="text-gray-500 text-sm">Your privacy is always protected.</p>
        </div>

      </div>

    </div>
  </div>

  <!-- CALL TO ACTION -->
  <div class="text-center py-16 px-4 bg-pink-600">
    <h2 class="text-3xl font-bold text-white mb-6">
      Ready to Book a Premium Experience?
    </h2>

    <%= link_to "Contact Now", contact_path,
        class: "inline-block bg-white text-pink-600 font-semibold px-8 py-3 rounded-full shadow-lg hover:bg-gray-100 transition duration-300" %>
  </div>

</div>