<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100 py-12 px-4">

  <div class="max-w-6xl mx-auto">

    <!-- Header Section -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-10 gap-4">

      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-pink-600">
          Our Rates
        </h2>
        <p class="text-gray-500 mt-1 text-sm sm:text-base">
          Transparent and premium pricing
        </p>
      </div>

      <% if admin_signed_in? %>
        <%= link_to "Add New Rate", new_rate_path,
            class: "bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-full shadow-lg transition duration-300 text-center" %>
      <% end %>

    </div>

    <!-- Desktop Table -->
    <div class="hidden md:block bg-white shadow-2xl rounded-3xl overflow-hidden border border-pink-100">

      <table class="min-w-full text-gray-700">

        <thead class="bg-pink-600 text-white text-sm uppercase tracking-wider">
          <tr>
            <th class="py-4 px-6 text-left">Name</th>
            <th class="py-4 px-6 text-left">Per Hour</th>
            <th class="py-4 px-6 text-left">Short</th>
            <th class="py-4 px-6 text-left">Full Night</th>
            <% if admin_signed_in? %>
            <th class="py-4 px-6 text-left">Actions</th>
          <% end %>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-100">

          <% @rates.each do |rate| %>
            <tr class="hover:bg-pink-50 transition duration-300">
              <td class="py-4 px-6 font-semibold text-pink-600">
                <%= rate.name %>
              </td>
              <td class="py-4 px-6">₹ <%= rate.rate_short %></td>
              <td class="py-4 px-6">₹ <%= rate.rate_per_hour %></td>
              <td class="py-4 px-6">₹ <%= rate.rate_full_night %></td>
              <% if admin_signed_in? %>
              <td class="py-4 px-6 space-x-2">
                <%= link_to "Edit", edit_rate_path(rate),
                    class: "bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded-lg text-sm cursor-pointer" %>
          
               <%= button_to "Delete",
                rate_path(rate),
                method: :delete,
                data: { turbo_confirm: "Are you sure?" },
                class: "bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-lg text-sm cursor-pointer",
                form: { class: "inline-block" } %>
              </td>
            <% end %>
            </tr>
          <% end %>

        </tbody>

      </table>

    </div>

    <!-- Mobile Card Layout -->
    <div class="md:hidden space-y-6">

      <% @rates.each do |rate| %>

        <div class="bg-white shadow-lg rounded-2xl p-6 border border-pink-100">

          <h3 class="text-xl font-bold text-pink-600 mb-4">
            <%= rate.name %>
          </h3>

          <div class="space-y-2 text-gray-600 text-sm">

          <p class="flex justify-between">
          <span>Short</span>
          <span class="font-medium">₹ <%= rate.rate_short %></span>
        </p>

            <p class="flex justify-between">
              <span>Per Hour</span>
              <span class="font-medium">₹ <%= rate.rate_per_hour %></span>
            </p>


            <p class="flex justify-between">
              <span>Full Night</span>
              <span class="font-medium">₹ <%= rate.rate_full_night %></span>
            </p>
          </div>

        </div>

      <% end %>

    </div>

  </div>

</div>