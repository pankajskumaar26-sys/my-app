<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100 flex items-center justify-center px-4 py-12">

  <div class="w-full max-w-2xl bg-white/80 backdrop-blur-lg shadow-2xl rounded-3xl p-8 sm:p-10 border border-pink-100">

    <!-- Heading -->
    <div class="text-center mb-8">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-pink-600">
        Add New Rate
      </h2>
      <p class="text-gray-500 mt-2 text-sm sm:text-base">
        Create pricing details for your service
      </p>
    </div>

    <%= form_with model: @rate, local: true do |f| %>

      <!-- Name -->
      <div class="mb-6">
        <%= f.label :name, class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.text_field :name,
              class: "w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none transition shadow-sm" %>
      </div>

      <div class="mb-6">
      <%= f.label :rate_short, "Short (₹)",
            class: "block text-sm font-semibold text-gray-700 mb-2" %>
      <%= f.number_field :rate_short,
            step: "0.01",
            class: "w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none transition shadow-sm" %>
    </div>


      <!-- Rate Per Hour -->
      <div class="mb-6">
        <%= f.label :rate_per_hour, "Rate Per Hour (₹)",
              class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.number_field :rate_per_hour,
              step: "0.01",
              class: "w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none transition shadow-sm" %>
      </div>





        <div class="mb-6">
          <%= f.label :rate_full_night, "Full Night (₹)",
                class: "block text-sm font-semibold text-gray-700 mb-2" %>
          <%= f.number_field :rate_full_night,
                step: "0.01",
                class: "w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-pink-500 focus:border-pink-500 outline-none transition shadow-sm" %>
        </div>

 

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 sm:justify-end">

        <%= link_to "Cancel", rates_path,
              class: "w-full sm:w-auto text-center bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium px-6 py-3 rounded-full transition duration-300 cursor-pointer" %>

        <%= f.submit "Create Rate",
              class: "w-full sm:w-auto bg-pink-600 hover:bg-pink-700 text-white font-semibold px-6 py-3 rounded-full shadow-lg transition duration-300 cursor-pointer" %>

      </div>

    <% end %>

  </div>

</div>