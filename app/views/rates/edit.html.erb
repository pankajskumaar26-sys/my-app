<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100 py-12 px-4">
  <div class="max-w-3xl mx-auto bg-white shadow-2xl rounded-3xl p-8 border border-pink-100">

    <!-- Header -->
    <div class="mb-8 text-center">
      <h2 class="text-3xl font-extrabold text-pink-600">
        Edit Rate
      </h2>
      <p class="text-gray-500 mt-2 text-sm">
        Update pricing details below
      </p>
    </div>

    <!-- Form -->
    <%= form_with(model: @rate, local: true) do |f| %>

      <% if @rate.errors.any? %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-600 p-4 rounded-xl">
          <h4 class="font-semibold mb-2">
            Please fix the following errors:
          </h4>
          <ul class="list-disc list-inside text-sm">
            <% @rate.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-6">

        <!-- Name -->
        <div>
          <%= f.label :name, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :name,
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:outline-none" %>
        </div>

        <!-- Short Rate -->
        <div>
          <%= f.label :rate_short, "Short Rate (₹)", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.number_field :rate_short,
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:outline-none" %>
        </div>

        <!-- Per Hour -->
        <div>
          <%= f.label :rate_per_hour, "Per Hour (₹)", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.number_field :rate_per_hour,
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:outline-none" %>
        </div>

        <!-- Full Night -->
        <div>
          <%= f.label :rate_full_night, "Full Night (₹)", class: "block text-gray-700 font-medium mb-2" %>
          <%= f.number_field :rate_full_night,
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500 focus:outline-none" %>
        </div>

      </div>

      <!-- Buttons -->
      <div class="mt-8 flex justify-between items-center">

        <%= link_to "Back",
            rates_path,
            class: "text-gray-600 hover:text-pink-600 font-medium" %>

        <%= f.submit "Update Rate",
            class: "bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-full shadow-lg transition duration-300 cursor-pointer" %>

      </div>

    <% end %>

  </div>
</div>