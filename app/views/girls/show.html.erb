<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100 px-4 sm:px-8 py-10">

  <div class="max-w-6xl mx-auto">

    <!-- PROFILE HEADER -->
    <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-10 mb-10">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-pink-600">
            <%= @girl.name %>, <%= @girl.age %>
          </h1>
          <p class="text-gray-500 mt-2 text-sm sm:text-base">
            📍 <%= @girl.city %>
          </p>
        </div>

        <%= link_to "⬅ Back", girls_path,
        class: "inline-flex items-center justify-center
                px-3 py-1.5 sm:px-5 sm:py-2
                text-xs sm:text-sm
                bg-gray-200 hover:bg-gray-300
                rounded-full transition" %>
      

      </div>

    </div>

    <!-- IMAGE GALLERY -->
    <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-8 mb-10">

      <h2 class="text-xl font-semibold text-gray-800 mb-6">
        📸 Gallery
      </h2>

      <% if @girl.images.attached? %>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">

          <% @girl.images.each do |img| %>
            <div class="relative overflow-hidden rounded-2xl group">
              <%= image_tag img,
                  class: "w-full h-48 sm:h-52 md:h-56 object-cover transition duration-500 group-hover:scale-110" %>
            </div>
          <% end %>

        </div>

      <% else %>
        <div class="h-48 bg-gray-200 flex items-center justify-center text-gray-400 rounded-xl">
          No Images Available
        </div>
      <% end %>

    </div>

    <!-- DETAILS SECTION -->
    <div class="bg-white rounded-3xl shadow-xl p-6 sm:p-8">

      <h2 class="text-xl font-semibold text-gray-800 mb-6">
        👤 Details
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">

        <div class="bg-pink-50 p-4 rounded-xl text-center">
          <span class="text-gray-600 text-sm">Height</span>
          <p class="font-semibold text-gray-800 mt-1"><%= @girl.height %></p>
        </div>

        <div class="bg-pink-50 p-4 rounded-xl text-center">
          <span class="text-gray-600 text-sm">Weight</span>
          <p class="font-semibold text-gray-800 mt-1"><%= @girl.weight %></p>
        </div>

        <div class="bg-pink-50 p-4 rounded-xl text-center">
          <span class="text-gray-600 text-sm">Body Type</span>
          <p class="font-semibold text-gray-800 mt-1"><%= @girl.body_type %></p>
        </div>

        <div class="bg-pink-50 p-4 rounded-xl text-center">
          <span class="text-gray-600 text-sm">Chest</span>
          <p class="font-semibold text-gray-800 mt-1"><%= @girl.chest_size %></p>
        </div>

      </div>

      <div class="mt-8">
        <h3 class="font-semibold text-gray-700 mb-3">About</h3>
        <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
          <%= @girl.description %>
        </p>
      </div>

    </div>

  </div>

</div>
