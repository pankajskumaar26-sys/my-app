<div class="min-h-screen bg-gradient-to-br from-pink-50 via-white to-pink-100 py-12 px-4">
  <div class="max-w-4xl mx-auto bg-white shadow-2xl rounded-3xl p-8 border border-pink-100">

    <!-- Header -->
    <div class="mb-8 text-center">
      <h2 class="text-3xl font-extrabold text-pink-600">
        Edit Profile
      </h2>
      <p class="text-gray-500 mt-2 text-sm">
        Update profile details below
      </p>
    </div>

    <%= form_with(model: @girl, local: true, html: { multipart: true }) do |f| %>

      <% if @girl.errors.any? %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-600 p-4 rounded-xl">
          <h4 class="font-semibold mb-2">
            Please fix the following errors:
          </h4>
          <ul class="list-disc list-inside text-sm">
            <% @girl.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Name -->
        <div>
          <%= f.label :name, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :name, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

        <!-- Age -->
        <div>
          <%= f.label :age, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.number_field :age, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

        <!-- City -->
        <div>
          <%= f.label :city, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :city, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

        <!-- Height -->
        <div>
          <%= f.label :height, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :height, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

        <!-- Weight -->
        <div>
          <%= f.label :weight, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :weight, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

        <!-- Body Type -->
        <div>
          <%= f.label :body_type, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :body_type, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

        <!-- Chest Size -->
        <div>
          <%= f.label :chest_size, class: "block text-gray-700 font-medium mb-2" %>
          <%= f.text_field :chest_size, class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
        </div>

      </div>

      <!-- Description -->
      <div class="mt-6">
        <%= f.label :description, class: "block text-gray-700 font-medium mb-2" %>
        <%= f.text_area :description, rows: 4,
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-pink-500" %>
      </div>

      <!-- Image Upload -->
      <div class="mt-6">
        <%= f.label :images, "Upload Images", class: "block text-gray-700 font-medium mb-2" %>
        <%= f.file_field :images, multiple: true,
            class: "w-full px-4 py-2 border border-gray-300 rounded-xl bg-white" %>
      </div>

      <!-- Existing Images Preview -->
      <% if @girl.images.attached? %>
        <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
          <% @girl.images.each do |image| %>
            <div class="relative">
              <%= image_tag image, class: "rounded-xl shadow-md h-32 w-full object-cover" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Buttons -->
      <div class="mt-8 flex justify-between items-center">
        <%= link_to "Back",
            girls_path,
            class: "text-gray-600 hover:text-pink-600 font-medium" %>

        <%= f.submit "Update Profile",
            class: "bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-full shadow-lg transition duration-300 cursor-pointer" %>
      </div>

    <% end %>

  </div>
</div>